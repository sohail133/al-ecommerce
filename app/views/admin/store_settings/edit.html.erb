<div class="mb-6">
  <h1 class="text-2xl font-bold text-gray-800">Edit Store Settings</h1>
  <p class="text-gray-600">Update your store contact information, shipping fee, and social media links</p>
</div>

<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
  <%= form_with model: [:admin, @store_setting], url: admin_store_setting_path, method: :patch, class: "space-y-6" do |f| %>
    <%= render "shared/form_errors", object: @store_setting %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, class: "form-input", required: true %>
      </div>
      <div>
        <%= f.label :phone_number, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :phone_number, class: "form-input", required: true %>
      </div>
      <div>
        <%= f.label :whatsapp_number, "WhatsApp Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :whatsapp_number,
            class: "form-input",
            placeholder: "+92 300 1234567" %>
        <p class="mt-1 text-xs text-gray-500">
          Include country code. Customers will open WhatsApp chat with this number. Leave blank to hide WhatsApp.
        </p>
      </div>
      <div class="md:col-span-2">
        <%= f.label :location, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :location, rows: 3, class: "form-input", required: true %>
      </div>
      <div>
        <%= f.label :shipping_fee, "Shipping Fee", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :shipping_fee, step: 0.01, min: 0, class: "form-input", required: true %>
        <p class="mt-1 text-xs text-gray-500">Applied to every order at checkout. Set to 0 for free shipping.</p>
      </div>
      <div>
        <%= f.label :facebook_url, "Facebook URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.url_field :facebook_url, class: "form-input", placeholder: "https://facebook.com/yourpage" %>
      </div>
      <div>
        <%= f.label :instagram_url, "Instagram URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.url_field :instagram_url, class: "form-input", placeholder: "https://instagram.com/yourpage" %>
      </div>
      <div>
        <%= f.label :youtube_url, "YouTube URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.url_field :youtube_url, class: "form-input", placeholder: "https://youtube.com/yourchannel" %>
      </div>
    </div>

    <div class="pt-6 border-t border-gray-200">
      <h2 class="text-lg font-semibold text-gray-800">Announcement Banner</h2>
      <p class="text-sm text-gray-600 mb-4">The message strip shown at the very top of every storefront page.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="md:col-span-2">
          <label class="flex items-center space-x-2">
            <%= f.check_box :banner_enabled, class: "form-checkbox" %>
            <span class="text-sm font-medium text-gray-700">Show the announcement message</span>
          </label>
          <p class="mt-1 text-xs text-gray-500">Unchecking hides the message only; the login and account links stay in place.</p>
        </div>

        <div class="md:col-span-2">
          <%= f.label :banner_text, "Banner Message", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :banner_text, class: "form-input", placeholder: StoreSetting::DEFAULT_BANNER_TEXT %>
        </div>

        <div>
          <%= f.label :banner_background_color, "Banner Background Color", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.color_field :banner_background_color,
              value: @store_setting.banner_background_color.presence || "#3fa66a",
              class: "h-10 w-full rounded-md border border-gray-300 cursor-pointer" %>
        </div>

        <div>
          <%= f.label :banner_text_color, "Banner Text Color", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.color_field :banner_text_color,
              value: @store_setting.banner_text_color.presence || "#ffffff",
              class: "h-10 w-full rounded-md border border-gray-300 cursor-pointer" %>
        </div>

        <div class="md:col-span-2">
          <label class="flex items-center space-x-2">
            <%= check_box_tag :use_theme_banner_colors, "1", @store_setting.banner_background_color.blank? && @store_setting.banner_text_color.blank?, class: "form-checkbox" %>
            <span class="text-sm font-medium text-gray-700">Use the site theme colors instead</span>
          </label>
          <p class="mt-1 text-xs text-gray-500">Keeps the banner matching the store theme and ignores the colors picked above.</p>
        </div>

        <div class="md:col-span-2">
          <span class="block text-sm font-medium text-gray-700 mb-1">Preview</span>
          <div class="<%= @store_setting.banner_css_classes %> py-2 px-4 rounded-md text-sm" style="<%= @store_setting.banner_style %>">
            <%= @store_setting.banner_visible? ? @store_setting.banner_text : "Message hidden" %>
          </div>
        </div>
      </div>
    </div>

    <div class="flex items-center space-x-3 pt-4 border-t border-gray-200">
      <%= link_to "Cancel", admin_store_setting_path, class: "btn-secondary" %>
      <%= f.submit "Update Settings", class: "btn-primary" %>
    </div>
  <% end %>
</div>
