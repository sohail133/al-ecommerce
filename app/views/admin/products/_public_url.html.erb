<% url = product.campaign_url %>

<% if local_assigns[:form] %>
  <div>
    <%= form.label :public_url, "Public URL", class: "block text-sm font-medium text-green-deep mb-1" %>
    <div class="flex items-stretch gap-2">
      <%= form.text_field :public_url,
          value: product.public_url.presence || url,
          placeholder: "https://www.mahnira.com/products/your-product",
          class: "form-input flex-1 text-sm",
          autocomplete: "off" %>
      <% if (product.public_url.presence || url).present? %>
        <button type="button"
                class="btn-secondary whitespace-nowrap"
                data-url="<%= product.public_url.presence || url %>"
                onclick="const input = this.parentElement.querySelector('input'); navigator.clipboard.writeText((input && input.value) || this.dataset.url).then(() => { const label = this.textContent; this.textContent = 'Copied'; setTimeout(() => this.textContent = label, 1500); })">
          Copy
        </button>
      <% end %>
    </div>
    <p class="text-xs text-green-muted mt-1">
      Used for Instagram / Facebook campaigns. Auto-filled on create if left blank; you can edit it anytime.
    </p>
  </div>
<% elsif url.present? %>
  <div>
    <label class="block text-sm font-medium text-green-muted mb-1">Public URL</label>
    <div class="flex items-stretch gap-2">
      <input type="text"
             readonly
             value="<%= url %>"
             class="form-input flex-1 text-sm bg-green-light/40"
             onclick="this.select()"
             aria-label="Product public URL">
      <button type="button"
              class="btn-secondary whitespace-nowrap"
              data-url="<%= url %>"
              onclick="navigator.clipboard.writeText(this.dataset.url).then(() => { const label = this.textContent; this.textContent = 'Copied'; setTimeout(() => this.textContent = label, 1500); })">
        Copy
      </button>
    </div>
    <p class="text-xs text-green-muted mt-1">
      Edit this from the product edit page if you need to change the campaign link.
    </p>
  </div>
<% else %>
  <div>
    <label class="block text-sm font-medium text-green-muted mb-1">Public URL</label>
    <p class="text-sm text-green-muted">
      Saved automatically after you create the product. Then you can edit or copy it for campaigns.
    </p>
  </div>
<% end %>
