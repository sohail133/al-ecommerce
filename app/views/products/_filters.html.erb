<div class="bg-white rounded-lg border border-pink-border shadow-sm p-4 lg:sticky lg:top-4" data-controller="filter-accordion">
  <button data-action="click->filter-accordion#toggle" class="flex items-center justify-between w-full text-left lg:cursor-default" type="button">
    <div class="flex items-center space-x-2">
      <%= render "shared/svg_icons/filter", class: "w-5 h-5 text-green-primary" %>
      <span class="text-sm font-medium text-green-deep">Filter Products</span>
      <% if params[:name].present? || params[:category_id].present? || params[:subcategory_id].present? || params[:min_price].present? || params[:max_price].present? || params[:sort].present? %>
        <span class="bg-green-primary text-white text-xs px-2 py-0.5 rounded-full">Active</span>
      <% end %>
    </div>
    <svg data-filter-accordion-target="icon" class="w-5 h-5 text-green-deep transition-transform duration-200 lg:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <div data-filter-accordion-target="content" class="hidden lg:block mt-4">
    <%= form_with url: products_path, method: :get, class: "space-y-4" do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :name, "Search", class: "block text-sm font-medium text-green-deep mb-1" %>
          <%= f.text_field :name, value: params[:name], placeholder: "Search products...", class: "form-input" %>
        </div>

        <div class="relative" data-controller="searchable-select" data-searchable-select-placeholder-value="All Categories">
          <%= f.label :category_id, "Category", class: "block text-sm font-medium text-green-deep mb-1" %>
          <select name="category_id"
                  id="category_id"
                  data-searchable-select-target="select"
                  class="sr-only"
                  tabindex="-1"
                  aria-hidden="true">
            <option value="" <%= "selected" if params[:category_id].blank? %>>All Categories</option>
            <% @categories.each do |category| %>
              <option value="<%= category.id %>" <%= "selected" if params[:category_id].to_s == category.id.to_s %>><%= category.name %></option>
            <% end %>
          </select>

          <button type="button"
                  data-searchable-select-target="trigger"
                  data-action="click->searchable-select#toggle"
                  class="form-select text-left cursor-pointer">
            <span data-searchable-select-target="label">All Categories</span>
          </button>

          <div data-searchable-select-target="menu" class="hidden absolute left-0 right-0 z-40 mt-1 bg-white border border-pink-border rounded-md shadow-lg overflow-hidden">
            <div class="p-2 border-b border-pink-border">
              <input type="text"
                     data-searchable-select-target="query"
                     data-action="input->searchable-select#filter keydown.escape->searchable-select#close"
                     placeholder="Search categories..."
                     class="w-full px-3 py-2 text-sm border border-pink-border rounded-md focus:outline-none focus:ring-green-primary focus:border-green-primary text-green-deep"
                     autocomplete="off">
            </div>
            <div class="max-h-48 overflow-y-auto py-1">
              <button type="button"
                      data-searchable-select-target="option"
                      data-action="click->searchable-select#choose"
                      data-value=""
                      class="w-full text-left px-3 py-2 text-sm text-green-deep hover:bg-green-light transition-colors">
                All Categories
              </button>
              <% @categories.each do |category| %>
                <button type="button"
                        data-searchable-select-target="option"
                        data-action="click->searchable-select#choose"
                        data-value="<%= category.id %>"
                        class="w-full text-left px-3 py-2 text-sm text-green-deep hover:bg-green-light transition-colors">
                  <%= category.name %>
                </button>
              <% end %>
            </div>
          </div>
        </div>

        <div class="relative"
             data-controller="searchable-select"
             data-searchable-select-placeholder-value="All Subcategories"
             data-searchable-select-depends-on="#category_id">
          <%= f.label :subcategory_id, "Subcategory", class: "block text-sm font-medium text-green-deep mb-1" %>
          <select name="subcategory_id"
                  id="subcategory_id"
                  data-searchable-select-target="select"
                  class="sr-only"
                  tabindex="-1"
                  aria-hidden="true">
            <option value="" <%= "selected" if params[:subcategory_id].blank? %>>All Subcategories</option>
            <% @subcategories.each do |subcategory| %>
              <option value="<%= subcategory.id %>"
                      data-category-id="<%= subcategory.category_id %>"
                      <%= "selected" if params[:subcategory_id].to_s == subcategory.id.to_s %>>
                <%= subcategory.name %>
              </option>
            <% end %>
          </select>

          <button type="button"
                  data-searchable-select-target="trigger"
                  data-action="click->searchable-select#toggle"
                  class="form-select text-left cursor-pointer">
            <span data-searchable-select-target="label">All Subcategories</span>
          </button>

          <div data-searchable-select-target="menu" class="hidden absolute left-0 right-0 z-40 mt-1 bg-white border border-pink-border rounded-md shadow-lg overflow-hidden">
            <div class="p-2 border-b border-pink-border">
              <input type="text"
                     data-searchable-select-target="query"
                     data-action="input->searchable-select#filter keydown.escape->searchable-select#close"
                     placeholder="Search subcategories..."
                     class="w-full px-3 py-2 text-sm border border-pink-border rounded-md focus:outline-none focus:ring-green-primary focus:border-green-primary text-green-deep"
                     autocomplete="off">
            </div>
            <div class="max-h-48 overflow-y-auto py-1">
              <button type="button"
                      data-searchable-select-target="option"
                      data-action="click->searchable-select#choose"
                      data-value=""
                      class="w-full text-left px-3 py-2 text-sm text-green-deep hover:bg-green-light transition-colors">
                All Subcategories
              </button>
              <% @subcategories.each do |subcategory| %>
                <button type="button"
                        data-searchable-select-target="option"
                        data-action="click->searchable-select#choose"
                        data-value="<%= subcategory.id %>"
                        data-category-id="<%= subcategory.category_id %>"
                        class="w-full text-left px-3 py-2 text-sm text-green-deep hover:bg-green-light transition-colors">
                  <%= subcategory.name %>
                </button>
              <% end %>
            </div>
          </div>
        </div>

        <div>
          <%= f.label :min_price, "Min Price (Rs)", class: "block text-sm font-medium text-green-deep mb-1" %>
          <%= f.number_field :min_price, value: params[:min_price], placeholder: "0.00", step: "0.01", min: "0", class: "form-input" %>
        </div>

        <div>
          <%= f.label :max_price, "Max Price (Rs)", class: "block text-sm font-medium text-green-deep mb-1" %>
          <%= f.number_field :max_price, value: params[:max_price], placeholder: "0.00", step: "0.01", min: "0", class: "form-input" %>
        </div>

        <div>
          <%= f.label :sort, "Sort By", class: "block text-sm font-medium text-green-deep mb-1" %>
          <%= f.select :sort,
              options_for_select([
                ["Newest First", "newest"],
                ["Price: Low to High", "price_asc"],
                ["Price: High to Low", "price_desc"],
                ["Name: A to Z", "name_asc"]
              ], params[:sort]),
              {},
              { class: "form-select" } %>
        </div>
      </div>

      <div class="flex flex-col space-y-2 pt-4 border-t border-pink-border">
        <%= f.submit "Apply Filters", class: "btn-primary w-full" %>
        <%= link_to "Clear Filters", products_path, class: "btn-secondary w-full text-center" %>
      </div>
    <% end %>
  </div>
</div>
