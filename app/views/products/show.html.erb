<%
  product_description = @product.seo_page_description
  product_image = seo_product_image(@product)
%>
<% content_for :seo do %>
  <%= seo_tags(
        title: @product.seo_page_title,
        description: product_description,
        canonical: Site.absolute_url(product_path(@product)),
        image: product_image,
        type: "product"
      ) %>
  <%= json_ld(product_json_ld(@product)) %>
  <%= json_ld(
        breadcrumb_json_ld(
          [
            { name: "Home", url: Site.absolute_url(root_path) },
            { name: @product.category.name, url: Site.absolute_url(category_path(@product.category)) },
            (@product.subcategory ? { name: @product.subcategory.name, url: Site.absolute_url(products_path(subcategory_id: @product.subcategory_id)) } : nil),
            { name: @product.title, url: Site.absolute_url(product_path(@product)) }
          ].compact
        )
      ) %>
<% end %>

<div class="min-h-screen bg-pink-lightest">
  <%= render "pages/shared/header" %>

  <main class="container mx-auto px-4 py-8">
    <nav class="mb-6 text-sm text-green-muted" aria-label="Breadcrumb">
      <%= link_to "Home", root_path, class: "hover:text-green-primary" %>
      <span class="mx-2">/</span>
      <%= link_to @product.category.name, category_path(@product.category), class: "hover:text-green-primary" %>
      <% if @product.subcategory %>
        <span class="mx-2">/</span>
        <%= link_to @product.subcategory.name, products_path(subcategory_id: @product.subcategory_id), class: "hover:text-green-primary" %>
      <% end %>
      <span class="mx-2">/</span>
      <span class="text-green-deep"><%= @product.title %></span>
    </nav>

    <div class="bg-white rounded-2xl border border-pink-border p-4 md:p-8 mb-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
        <div>
          <% if @product.cover_image.attached? %>
            <%= image_tag @product.cover_image, alt: @product.title, loading: "eager", fetchpriority: "high", class: "w-full aspect-square object-cover rounded-2xl mb-4", width: 800, height: 800 %>
          <% elsif @product.images.attached? %>
            <%= image_tag @product.images.first, alt: @product.title, loading: "eager", fetchpriority: "high", class: "w-full aspect-square object-cover rounded-2xl mb-4", width: 800, height: 800 %>
          <% else %>
            <div class="w-full aspect-square bg-green-light rounded-2xl mb-4 flex items-center justify-center">
              <span class="text-6xl font-bold text-green-primary"><%= @product.title.first(2).upcase %></span>
            </div>
          <% end %>

          <% if @product.images.attached? && @product.images.count > 1 %>
            <div class="grid grid-cols-4 gap-2">
              <% @product.images.take(4).each do |image| %>
                <%= image_tag image, alt: "#{@product.title} gallery image", loading: "lazy", class: "w-full aspect-square object-cover rounded-xl border border-pink-border", width: 200, height: 200 %>
              <% end %>
            </div>
          <% end %>
        </div>

        <div>
          <div class="flex flex-wrap gap-2 mb-3">
            <span class="inline-block bg-green-light text-green-primary text-xs px-3 py-1 rounded-full font-semibold uppercase tracking-wide">
              <%= @product.category.name %>
            </span>
            <% if @product.subcategory %>
              <span class="inline-block bg-pink-light text-green-deep text-xs px-3 py-1 rounded-full font-semibold uppercase tracking-wide">
                <%= @product.subcategory.name %>
              </span>
            <% end %>
          </div>

          <h1 class="text-3xl md:text-4xl font-bold text-green-deep mb-3"><%= @product.title %></h1>

          <div class="flex items-center mb-5">
            <% avg_rating = @product.average_rating %>
            <% review_count = @product.review_count %>
            <% 5.times do |i| %>
              <%= render "shared/svg_icons/star", class: "w-4 h-4 #{review_count > 0 && i < avg_rating.to_i ? 'text-yellow-400' : 'text-gray-300'}" %>
            <% end %>
            <span class="text-sm text-green-muted ml-2">
              <% if review_count > 0 %>
                <%= avg_rating %> · <%= review_count %> <%= review_count == 1 ? "review" : "reviews" %>
              <% else %>
                No reviews yet
              <% end %>
            </span>
          </div>

          <% if @product.description.present? %>
            <p class="text-green-muted leading-relaxed mb-6"><%= @product.description %></p>
          <% end %>

          <%= render "products/variant_picker", product: @product %>

          <% if @product.category.name == "Jewelry" %>
            <ul class="mt-6 space-y-2 text-sm text-green-deep">
              <li class="flex items-center gap-2"><span class="text-green-primary font-bold">✓</span> Anti Tarnish</li>
              <li class="flex items-center gap-2"><span class="text-green-primary font-bold">✓</span> Hypoallergenic</li>
              <li class="flex items-center gap-2"><span class="text-green-primary font-bold">✓</span> Water Resistance</li>
              <li class="flex items-center gap-2"><span class="text-green-primary font-bold">✓</span> Premium Quality</li>
            </ul>
          <% end %>

          <div class="mt-8 pt-6 border-t border-pink-border grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
            <div>
              <p class="font-semibold text-green-deep">Cash on Delivery</p>
              <p class="text-green-muted">Pay when you receive</p>
            </div>
            <div>
              <p class="font-semibold text-green-deep">Easy Exchange</p>
              <p class="text-green-muted">Hassle-free support</p>
            </div>
            <div>
              <p class="font-semibold text-green-deep">Quality Checked</p>
              <p class="text-green-muted">Packed with care</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% product_reviews = Review.joins(order_item: :product_variant)
                               .where(product_variants: { product_id: @product.id })
                               .includes(:user, order_item: { product_variant: :product })
                               .recent %>

    <% if product_reviews.any? %>
      <div class="bg-white rounded-2xl border border-pink-border p-6 md:p-8 mb-10">
        <h2 class="text-2xl font-bold text-green-deep mb-6">Loved by customers</h2>
        <div class="space-y-6">
          <% product_reviews.each do |review| %>
            <div class="border-b border-pink-border pb-6 last:border-0 last:pb-0">
              <div class="flex items-start justify-between mb-3">
                <div class="flex items-center space-x-4">
                  <%= user_avatar(review.user, size: 12, class_names: "flex-shrink-0") %>
                  <div>
                    <p class="font-semibold text-green-deep"><%= review.user.full_name %></p>
                    <p class="text-xs text-green-muted"><%= review.created_at.strftime("%B %d, %Y") %></p>
                  </div>
                </div>
                <div class="flex items-center">
                  <% 5.times do |i| %>
                    <%= render "shared/svg_icons/star", class: "w-4 h-4 #{i < review.rating ? 'text-yellow-400' : 'text-gray-300'}" %>
                  <% end %>
                </div>
              </div>
              <p class="text-green-deep"><%= review.comment %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @related_products.any? %>
      <div class="mb-8">
        <div class="flex items-end justify-between mb-6">
          <div>
            <h2 class="text-2xl font-bold text-green-deep">You may also like</h2>
            <p class="text-green-muted text-sm mt-1">More pieces from this collection</p>
          </div>
          <%= link_to "View all", category_path(@product.category), class: "text-sm font-semibold text-green-primary hover:text-green-dark" %>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <% @related_products.each_with_index do |product, index| %>
            <%= render "shared/product_card", product: product, index: index, clickable: true %>
          <% end %>
        </div>
      </div>
    <% end %>
  </main>

  <%= render "pages/shared/footer" %>
</div>
