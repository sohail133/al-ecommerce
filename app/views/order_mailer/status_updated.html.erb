<div style="font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
  <h2 style="color: #2d5016; font-size: 26px; font-weight: bold; margin: 0 0 25px 0; line-height: 1.3;">
    Hello <%= @user.full_name.presence || @user.email %>,
  </h2>

  <p style="color: #333333; font-size: 16px; line-height: 1.7; margin: 0 0 24px 0;">
    Your order <strong style="color: #4a7c59; font-weight: 600;">#<%= @order.display_number %></strong> status has been updated.
  </p>

  <div style="background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%); padding: 20px 24px; border-left: 5px solid #4a7c59; margin: 0 0 28px 0; border-radius: 6px;">
    <p style="margin: 0 0 8px 0; font-weight: 700; color: #2d5016; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;">
      Status Update
    </p>
    <p style="margin: 0; color: #1b5e20; font-size: 15px; line-height: 1.8;">
      <% if @previous_status.present? %>
        Previous status: <strong><%= @previous_status.to_s.humanize %></strong><br>
      <% end %>
      New status: <strong><%= @current_status.to_s.humanize %></strong>
    </p>
  </div>

  <h3 style="color: #2d5016; font-size: 18px; font-weight: 700; margin: 0 0 16px 0;">Order Details</h3>

  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom: 20px;">
    <%= render "order_mailer/order_items" %>
  </table>

  <div style="border-top: 2px solid #f0e4e4; padding-top: 16px; margin-bottom: 28px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
      <tr>
        <td style="color: #666666; font-size: 14px; padding-bottom: 8px;">Subtotal</td>
        <td style="color: #2d5016; font-size: 14px; text-align: right; padding-bottom: 8px;"><%= format_currency(@order.items_subtotal) %></td>
      </tr>
      <tr>
        <td style="color: #666666; font-size: 14px; padding-bottom: 8px;">Shipping</td>
        <td style="color: #2d5016; font-size: 14px; text-align: right; padding-bottom: 8px;"><%= format_shipping_fee(@order.shipping_fee) %></td>
      </tr>
      <tr>
        <td style="color: #2d5016; font-size: 16px; font-weight: 700;">Total Amount</td>
        <td style="color: #4a7c59; font-size: 20px; font-weight: 700; text-align: right;"><%= format_currency(@order.total_amount) %></td>
      </tr>
    </table>
  </div>

  <p style="color: #333333; font-size: 15px; line-height: 1.7; margin: 0 0 24px 0;">
    You can view your full order details anytime from your account dashboard.
  </p>

  <div style="margin-top: 32px; padding-top: 20px; border-top: 3px solid #e8f5e9;">
    <p style="margin: 0 0 8px 0; color: #2d5016; font-size: 15px; font-weight: 700;">Best regards,</p>
    <p style="margin: 0 0 5px 0; color: #4a7c59; font-size: 15px; font-weight: 600;">Mahnira Team</p>
    <p style="margin: 8px 0 0 0; color: #666666; font-size: 13px;">
      <a href="mailto:<%= @store_setting.email %>" style="color: #4a7c59; text-decoration: none; font-weight: 500;"><%= @store_setting.email %></a>
    </p>
  </div>
</div>
