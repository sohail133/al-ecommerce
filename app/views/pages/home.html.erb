<% content_for :seo do %>
  <%= seo_tags(
        title: "Mahnira | Toys, Clothing, Jewelry & More Online in Pakistan",
        description: "Shop toys, clothing, jewelry and more at Mahnira. Discover quality products, new arrivals and convenient online shopping across Pakistan.",
        canonical: Site.absolute_url(root_path),
        image: Site::DEFAULT_OG_IMAGE,
        type: "website"
      ) %>
  <%= json_ld(organization_json_ld) %>
  <%= json_ld(website_json_ld) %>
<% end %>

<div class="min-h-screen bg-pink-lightest">
  <%= render "pages/shared/header" %>

  <main>

  <section class="relative overflow-hidden" data-controller="hero-slider" data-hero-slider-interval-value="5000">
    <div class="relative h-[520px] md:h-[620px] lg:h-[700px]">
      <% if @hero_images.any? %>
        <% @hero_images.each_with_index do |hero_image, index| %>
          <% if hero_image.images.attached? %>
            <% hero_image.images.each_with_index do |image, img_index| %>
              <% slide_active = index == 0 && img_index == 0 %>
              <div data-hero-slider-target="slide" class="absolute inset-0 transition-opacity duration-1000 <%= 'hidden opacity-0' unless slide_active %>">
                <div class="relative h-full bg-cover bg-center" style="background-image: linear-gradient(rgba(101, 97, 118, 0.35), rgba(101, 97, 118, 0.45)), url('<%= url_for(image) %>');" role="img" aria-label="<%= hero_image.title %>">
                  <div class="container mx-auto px-4 h-full flex items-center">
                    <div class="text-white max-w-xl">
                      <% if hero_image.subtitle.present? %>
                        <p class="text-sm md:text-base mb-3 uppercase tracking-[0.2em] font-medium text-white/90"><%= hero_image.subtitle %></p>
                      <% end %>
                      <% if slide_active %>
                        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 leading-tight"><%= hero_image.title %></h1>
                      <% else %>
                        <p class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 leading-tight"><%= hero_image.title %></p>
                      <% end %>
                      <% if hero_image.description.present? %>
                        <p class="text-base md:text-lg mb-8 text-white/90 max-w-md"><%= hero_image.description %></p>
                      <% end %>
                      <%= link_to "Shop Now", products_path, class: "inline-block bg-white text-green-primary px-8 py-3 rounded-full font-semibold hover:bg-green-light hover:text-green-deep transition-all duration-200" %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <div class="absolute inset-0 bg-gradient-to-br from-green-primary to-green-dark flex items-center justify-center">
          <div class="text-white text-center px-4">
            <p class="uppercase tracking-[0.25em] text-sm mb-3 text-white/80">New Collection</p>
            <h1 class="text-4xl md:text-6xl font-bold mb-4">Pieces you'll love</h1>
            <p class="text-lg mb-8 text-white/90">Jewelry & fashion, curated for everyday elegance</p>
            <%= link_to "Shop Now", products_path, class: "inline-block bg-white text-green-primary px-8 py-3 rounded-full font-semibold hover:bg-green-light transition-all duration-200" %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @hero_images.any? && @hero_images.sum { |hi| hi.images.count } > 1 %>
      <button type="button" aria-label="Previous slide" data-action="click->hero-slider#previous" class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white p-3 rounded-full shadow transition-all duration-200 z-10">
        <%= render "shared/svg_icons/chevron_left", class: "w-5 h-5 text-green-deep" %>
      </button>
      <button type="button" aria-label="Next slide" data-action="click->hero-slider#next" class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white p-3 rounded-full shadow transition-all duration-200 z-10">
        <%= render "shared/svg_icons/chevron_right", class: "w-5 h-5 text-green-deep" %>
      </button>
      <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex space-x-2 z-10" role="tablist" aria-label="Hero slides">
        <% total_slides = @hero_images.sum { |hi| hi.images.count } %>
        <% total_slides.times do |index| %>
          <button type="button" aria-label="Go to slide <%= index + 1 %>" data-action="click->hero-slider#goToSlide" data-index="<%= index %>" class="w-2.5 h-2.5 rounded-full bg-white/50 hover:bg-white transition-colors duration-200"></button>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="py-10 bg-white border-b border-pink-border">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
        <div>
          <p class="font-semibold text-green-deep">Cash on Delivery</p>
          <p class="text-sm text-green-muted mt-1">Pay securely when your order arrives</p>
        </div>
        <div>
          <p class="font-semibold text-green-deep">Quality Checked</p>
          <p class="text-sm text-green-muted mt-1">Every piece packed with care</p>
        </div>
        <div>
          <p class="font-semibold text-green-deep">Easy Support</p>
          <p class="text-sm text-green-muted mt-1">We're here if you need help</p>
        </div>
      </div>
    </div>
  </section>

  <section id="categories" class="py-14 bg-pink-lightest">
    <div class="container mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold text-green-deep mb-2">Shop by Category</h2>
        <p class="text-green-muted">Browse collections the easy way</p>
      </div>

      <% if @shop_collections.any? %>
        <div class="flex gap-6 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-thin justify-start md:justify-center">
          <% @shop_collections.each do |collection| %>
            <%= link_to products_path(subcategory_id: collection.id), class: "snap-start flex-shrink-0 group w-28 text-center" do %>
              <div class="w-28 h-28 rounded-full overflow-hidden border-2 border-pink-border group-hover:border-green-primary transition-all duration-300 mx-auto mb-3 bg-white shadow-sm">
                <% if collection.image.attached? %>
                  <%= image_tag collection.image, alt: collection.name, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
                <% elsif collection.category.image.attached? %>
                  <%= image_tag collection.category.image, alt: collection.name, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
                <% else %>
                  <div class="w-full h-full bg-green-light flex items-center justify-center">
                    <span class="text-xl font-bold text-green-primary"><%= collection.name.first(2).upcase %></span>
                  </div>
                <% end %>
              </div>
              <p class="text-sm font-semibold text-green-deep group-hover:text-green-primary transition-colors"><%= collection.name %></p>
              <p class="text-[11px] text-green-muted"><%= collection.category.name %></p>
            <% end %>
          <% end %>
        </div>
      <% elsif @categories.any? %>
        <div class="flex gap-6 overflow-x-auto pb-4 snap-x snap-mandatory justify-start md:justify-center">
          <% @categories.each do |category| %>
            <%= link_to category_path(category), class: "snap-start flex-shrink-0 group w-28 text-center" do %>
              <div class="w-28 h-28 rounded-full overflow-hidden border-2 border-pink-border group-hover:border-green-primary transition-all duration-300 mx-auto mb-3 bg-white shadow-sm">
                <% if category.image.attached? %>
                  <%= image_tag category.image, alt: category.name, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
                <% else %>
                  <div class="w-full h-full bg-green-light flex items-center justify-center">
                    <span class="text-xl font-bold text-green-primary"><%= category.name.first(2).upcase %></span>
                  </div>
                <% end %>
              </div>
              <p class="text-sm font-semibold text-green-deep group-hover:text-green-primary transition-colors"><%= category.name %></p>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="text-center text-green-muted">No collections available yet.</p>
      <% end %>
    </div>
  </section>

  <section id="products" class="py-14 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex items-end justify-between mb-8 gap-4">
        <div>
          <h2 class="text-3xl font-bold text-green-deep">New Arrivals</h2>
          <p class="text-green-muted text-sm mt-1">Fresh pieces just added</p>
        </div>
        <%= link_to "View all", new_arrivals_path, class: "text-sm font-semibold text-green-primary hover:text-green-dark" %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <% if @new_arrivals.any? %>
          <% @new_arrivals.each_with_index do |product, index| %>
            <%= render "shared/product_card", product: product, index: index, clickable: true, show_badge: true, badge_text: "New" %>
          <% end %>
        <% elsif @featured_products.any? %>
          <% @featured_products.each_with_index do |product, index| %>
            <%= render "shared/product_card", product: product, index: index, clickable: true %>
          <% end %>
        <% else %>
          <div class="col-span-full text-center py-12 text-green-muted">No products available yet.</div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="py-14 bg-pink-lightest">
    <div class="container mx-auto px-4">
      <div class="flex items-end justify-between mb-8 gap-4">
        <div>
          <h2 class="text-3xl font-bold text-green-deep">Best Sellers</h2>
          <p class="text-green-muted text-sm mt-1">Loved by our customers</p>
        </div>
        <%= link_to "Shop all", products_path, class: "text-sm font-semibold text-green-primary hover:text-green-dark" %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <% if @best_sellers.any? %>
          <% @best_sellers.each_with_index do |product, index| %>
            <%= render "shared/product_card", product: product, index: index, show_badge: true, badge_text: "Best Seller", clickable: true %>
          <% end %>
        <% else %>
          <div class="col-span-full text-center py-12 text-green-muted">No best sellers yet.</div>
        <% end %>
      </div>
    </div>
  </section>

  <% if @categories.any? %>
    <section class="py-14 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-green-deep mb-2">Explore Collections</h2>
          <p class="text-green-muted">Find your next favorite piece</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <% @categories.first(2).each do |category| %>
            <%= link_to category_path(category), class: "group relative min-h-[280px] rounded-2xl overflow-hidden" do %>
              <% if category.image.attached? %>
                <%= image_tag category.image, alt: category.name, class: "absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" %>
              <% else %>
                <div class="absolute inset-0 bg-gradient-to-br from-green-primary to-green-dark"></div>
              <% end %>
              <div class="absolute inset-0 bg-gradient-to-t from-green-deep/80 via-green-deep/20 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-8">
                <h3 class="text-3xl font-bold text-white mb-2"><%= category.name %></h3>
                <span class="inline-block text-sm font-semibold text-white border border-white/70 px-4 py-2 rounded-full group-hover:bg-white group-hover:text-green-primary transition-all">Shop now</span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <section class="py-14 bg-pink-lightest">
    <div class="container mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-green-deep mb-2">Loved by customers</h2>
        <p class="text-green-muted">Real reviews from real shoppers</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <% if @recent_reviews.any? %>
          <% @recent_reviews.first(3).each do |review| %>
            <div class="bg-white rounded-2xl border border-pink-border p-6">
              <div class="flex items-center mb-4">
                <% 5.times do |i| %>
                  <%= render "shared/svg_icons/star", class: "w-4 h-4 #{i < review.rating ? 'text-yellow-400' : 'text-gray-300'}" %>
                <% end %>
              </div>
              <p class="text-green-deep mb-5 leading-relaxed line-clamp-4"><%= review.comment %></p>
              <div class="flex items-center">
                <%= user_avatar(review.user, size: 10, class_names: "flex-shrink-0") %>
                <div class="ml-3">
                  <p class="text-sm font-semibold text-green-deep"><%= review.user.full_name %></p>
                  <p class="text-xs text-green-muted">Verified customer</p>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="col-span-full text-center text-green-muted py-8">Be the first to leave a review.</div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="py-16 bg-green-primary text-white">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-3">Stay in the loop</h2>
        <p class="text-white/90 mb-8">New drops, offers, and styling ideas — straight to your inbox</p>
        <%= form_with model: Subscriber.new, url: subscribers_path, class: "flex flex-col sm:flex-row gap-3 max-w-xl mx-auto" do |f| %>
          <%= f.email_field :email,
              placeholder: "Enter your email",
              required: true,
              class: "flex-1 px-6 py-3 rounded-full text-green-deep focus:outline-none focus:ring-2 focus:ring-white" %>
          <%= f.submit "Subscribe",
              class: "bg-white text-green-primary px-8 py-3 rounded-full font-semibold hover:bg-green-light hover:text-green-deep transition-all duration-200 cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </section>
  </main>

  <%= render "pages/shared/footer" %>
</div>
