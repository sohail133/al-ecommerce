<%
  product ||= nil
  image_url ||= nil
  show_badge ||= false
  badge_text ||= nil
  index ||= 0
  clickable ||= false
  card_id = product.present? ? "product-card-#{product.id}" : "product-card-placeholder-#{index}"
  first_variant = product&.product_variants&.detect(&:active?) || product&.product_variants&.first
  has_options = product.present? && product.product_variants.size > 1
%>

<div id="<%= card_id %>"
     class="bg-white rounded-2xl border border-pink-border overflow-hidden group hover:shadow-lg transition-all duration-300 relative"
     data-aos="fade-up"
     data-aos-delay="<%= index * 80 %>">

  <div class="relative aspect-[4/5] overflow-hidden bg-pink-lightest">
    <% if clickable && product.present? %>
      <%= link_to product_path(product), class: "block h-full w-full" do %>
        <%= render "shared/product_card_image", product: product, image_url: image_url %>
      <% end %>
    <% else %>
      <%= render "shared/product_card_image", product: product, image_url: image_url %>
    <% end %>

    <% if show_badge && badge_text.present? %>
      <div class="absolute top-3 left-3 bg-green-primary text-white text-[11px] px-3 py-1 rounded-full font-semibold tracking-wide z-10">
        <%= badge_text %>
      </div>
    <% end %>

    <div class="absolute top-3 right-3 z-20">
      <% if product.present? && user_signed_in? %>
        <% is_favorited = defined?(@favorited_product_ids) && @favorited_product_ids ? @favorited_product_ids.include?(product.id) : current_user.favorited?(product.id) %>
        <%= form_with url: is_favorited ? unfavorite_product_path(product) : favorite_product_path(product),
            method: is_favorited ? :delete : :post,
            data: { turbo_method: is_favorited ? :delete : :post, controller: "favorite" },
            class: "inline-block m-0 p-0",
            id: "favorite-form-card-#{product.id}" do |f| %>
          <%= f.button type: :submit,
              class: "w-9 h-9 bg-white/95 rounded-full flex items-center justify-center hover:bg-pink-accent hover:text-white transition-all duration-200 shadow-sm #{'text-pink-accent' if is_favorited}",
              data: { action: "click->favorite#submit" },
              id: "favorite-button-card-#{product.id}" do %>
            <% if is_favorited %>
              <%= render "shared/svg_icons/heart_filled", class: "w-4 h-4" %>
            <% else %>
              <%= render "shared/svg_icons/heart", class: "w-4 h-4" %>
            <% end %>
          <% end %>
        <% end %>
      <% elsif product.present? %>
        <%= link_to new_user_session_path, class: "w-9 h-9 bg-white/95 rounded-full flex items-center justify-center hover:bg-pink-accent hover:text-white transition-all duration-200 shadow-sm" do %>
          <%= render "shared/svg_icons/heart", class: "w-4 h-4" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="p-4">
    <% if product.present? %>
      <p class="text-[11px] text-green-muted font-semibold mb-1 uppercase tracking-wider">
        <%= product.subcategory&.name || product.category.name %>
      </p>
      <% if clickable %>
        <%= link_to product.title, product_path(product), class: "block text-base font-semibold text-green-deep mb-2 line-clamp-2 hover:text-green-primary transition-colors duration-200" %>
      <% else %>
        <h3 class="text-base font-semibold text-green-deep mb-2 line-clamp-2"><%= product.title %></h3>
      <% end %>
    <% else %>
      <p class="text-[11px] text-green-muted font-semibold mb-1 uppercase tracking-wider">Collection</p>
      <h3 class="text-base font-semibold text-green-deep mb-2">Premium Product</h3>
    <% end %>

    <div class="flex items-center justify-between gap-3 pt-1">
      <div>
        <% if product.present? %>
          <span class="text-lg font-bold text-green-primary">
            <%= format_currency(first_variant&.price || product.price) %>
          </span>
          <% if has_options %>
            <p class="text-xs text-green-muted mt-0.5">Options available</p>
          <% end %>
        <% else %>
          <span class="text-lg font-bold text-green-primary"><%= format_currency(99.99) %></span>
        <% end %>
      </div>

      <% if product.present? && has_options %>
        <%= link_to product_path(product), class: "bg-green-primary text-white px-4 py-2 rounded-full hover:bg-green-dark transition-all duration-200 text-sm font-semibold whitespace-nowrap" do %>
          Select options
        <% end %>
      <% elsif product.present? && first_variant.present? %>
        <%= form_with url: add_to_cart_path, method: :post, class: "inline" do |f| %>
          <%= f.hidden_field :variant_id, value: first_variant.id %>
          <%= f.hidden_field :quantity, value: 1 %>
          <%= f.button type: :submit, class: "bg-green-primary text-white px-4 py-2 rounded-full hover:bg-green-dark transition-all duration-200 flex items-center space-x-2 text-sm font-semibold" do %>
            <%= render "shared/svg_icons/cart", class: "w-4 h-4" %>
            <span>Add</span>
          <% end %>
        <% end %>
      <% else %>
        <button type="button" class="bg-green-primary/60 text-white px-4 py-2 rounded-full text-sm font-semibold" disabled>
          Unavailable
        </button>
      <% end %>
    </div>
  </div>
</div>
