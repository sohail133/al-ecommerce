<%
  product ||= nil
  image_url ||= nil
  show_badge ||= false
  badge_text ||= nil
  index ||= 0
  clickable ||= false
  card_id = product.present? ? "product-card-#{product.id}" : "product-card-placeholder-#{index}"
  first_variant = product&.product_variants&.first
%>

<div id="<%= card_id %>"
     class="bg-white rounded-lg shadow-sm border border-pink-border overflow-hidden group hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 relative"
     data-aos="fade-up"
     data-aos-delay="<%= index * 100 %>"
     <% if product.present? && product.product_variants.any? %>
       data-controller="product-variant"
     <% end %>>

  <div class="relative h-64 overflow-hidden">
    <% if clickable && product.present? %>
      <%= link_to product_path(product), class: "block h-full w-full" do %>
        <%= render "shared/product_card_image", product: product, image_url: image_url %>
      <% end %>
    <% else %>
      <%= render "shared/product_card_image", product: product, image_url: image_url %>
    <% end %>

    <% if show_badge && badge_text.present? %>
      <div class="absolute top-4 left-4 bg-pink-accent text-white text-xs px-3 py-1 rounded-full font-semibold shadow-lg animate-pulse z-10">
        <%= badge_text %>
      </div>
    <% end %>

    <div class="absolute top-4 right-4 flex flex-col space-y-2 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-x-4 group-hover:translate-x-0 z-30">
      <% if product.present? && user_signed_in? %>
        <% is_favorited = defined?(@favorited_product_ids) && @favorited_product_ids ? @favorited_product_ids.include?(product.id) : current_user.favorited?(product.id) %>
        <%= form_with url: is_favorited ? unfavorite_product_path(product) : favorite_product_path(product),
            method: is_favorited ? :delete : :post,
            data: { turbo_method: is_favorited ? :delete : :post, controller: "favorite" },
            class: "inline-block m-0 p-0",
            id: "favorite-form-card-#{product.id}" do |f| %>
          <%= f.button type: :submit,
              class: "w-10 h-10 bg-white rounded-full flex items-center justify-center hover:bg-pink-accent hover:text-white transition-all duration-200 shadow-lg transform hover:scale-110 #{'text-pink-accent' if is_favorited}",
              data: { action: "click->favorite#submit" },
              id: "favorite-button-card-#{product.id}" do %>
            <% if is_favorited %>
              <%= render "shared/svg_icons/heart_filled", class: "w-5 h-5" %>
            <% else %>
              <%= render "shared/svg_icons/heart", class: "w-5 h-5" %>
            <% end %>
          <% end %>
        <% end %>
      <% elsif product.present? %>
        <%= link_to new_user_session_path, class: "w-10 h-10 bg-white rounded-full flex items-center justify-center hover:bg-pink-accent hover:text-white transition-all duration-200 shadow-lg transform hover:scale-110" do %>
          <%= render "shared/svg_icons/heart", class: "w-5 h-5" %>
        <% end %>
      <% end %>

      <% if product.present? %>
        <%= link_to product_path(product), class: "w-10 h-10 bg-white rounded-full flex items-center justify-center hover:bg-green-primary hover:text-white transition-all duration-200 shadow-lg transform hover:scale-110" do %>
          <%= render "shared/svg_icons/eye", class: "w-5 h-5" %>
        <% end %>
      <% end %>
    </div>

    <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
  </div>

  <div class="p-4">
    <% if product.present? %>
      <p class="text-xs text-green-primary font-semibold mb-1 uppercase tracking-wide"><%= product.category.name %></p>
      <% if clickable %>
        <%= link_to product.title, product_path(product), class: "block text-lg font-semibold text-green-deep mb-2 truncate group-hover:text-green-primary transition-colors duration-200 hover:text-green-primary" %>
      <% else %>
        <h3 class="text-lg font-semibold text-green-deep mb-2 truncate group-hover:text-green-primary transition-colors duration-200"><%= product.title %></h3>
      <% end %>
    <% else %>
      <p class="text-xs text-green-primary font-semibold mb-1 uppercase tracking-wide">Electronics</p>
      <h3 class="text-lg font-semibold text-green-deep mb-2 group-hover:text-green-primary transition-colors duration-200">Premium Product</h3>
    <% end %>

    <div class="flex items-center mb-3">
      <% if product.present? %>
        <% avg_rating = product.average_rating %>
        <% review_count = product.review_count %>
        <% if review_count > 0 %>
          <% 5.times do |i| %>
            <%= render "shared/svg_icons/star", class: "w-4 h-4 #{i < avg_rating.to_i ? 'text-yellow-400' : 'text-gray-300'}" %>
          <% end %>
          <span class="text-sm text-green-muted ml-2">(<%= avg_rating %>)</span>
          <span class="text-xs text-green-muted ml-2">· <%= review_count %> <%= review_count == 1 ? 'review' : 'reviews' %></span>
        <% else %>
          <% 5.times do |i| %>
            <%= render "shared/svg_icons/star", class: "w-4 h-4 text-gray-300" %>
          <% end %>
          <span class="text-sm text-green-muted ml-2">(0.0)</span>
          <span class="text-xs text-green-muted ml-2">· No reviews yet</span>
        <% end %>
      <% else %>
        <% 5.times do |i| %>
          <%= render "shared/svg_icons/star", class: "w-4 h-4 text-yellow-400" %>
        <% end %>
        <span class="text-sm text-green-muted ml-2">(4.8)</span>
        <span class="text-xs text-green-muted ml-2">· 124 reviews</span>
      <% end %>
    </div>

    <% if product&.product_variants&.any? %>
      <div class="mb-3">
        <p class="text-xs text-green-muted mb-2">Variants:</p>
        <div class="flex flex-wrap gap-2">
          <% product.product_variants.limit(3).each_with_index do |variant, variant_index| %>
            <button type="button"
                    data-product-variant-target="variant"
                    data-action="click->product-variant#select"
                    data-variant-id="<%= variant.id %>"
                    data-variant-price="<%= variant.price %>"
                    data-variant-price-formatted="<%= format_currency(variant.price) %>"
                    class="px-3 py-1 text-xs border-2 rounded-full transition-all duration-200 transform hover:scale-105 <%= variant_index.zero? ? 'border-green-primary bg-green-light text-green-primary' : 'border-pink-border bg-white hover:border-green-primary hover:text-green-primary hover:bg-green-light' %>">
              <%= variant.name %>
            </button>
          <% end %>
          <% if product.product_variants.count > 3 %>
            <%= link_to "+#{product.product_variants.count - 3} more", product_path(product), class: "px-3 py-1 text-xs text-green-primary font-semibold hover:underline" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="flex items-center justify-between pt-3 border-t border-pink-border">
      <div>
        <% if product.present? %>
          <span class="text-2xl font-bold text-green-primary" data-product-variant-target="price">
            <%= format_currency(first_variant&.price || product.price) %>
          </span>
        <% else %>
          <span class="text-2xl font-bold text-green-primary"><%= format_currency(99.99) %></span>
        <% end %>
      </div>

      <% if product.present? && first_variant.present? %>
        <%= form_with url: add_to_cart_path, method: :post, class: "inline" do |f| %>
          <%= f.hidden_field :variant_id, value: first_variant.id, data: { product_variant_target: "input" } %>
          <%= f.hidden_field :quantity, value: 1 %>
          <%= f.button type: :submit, class: "bg-green-primary text-white px-6 py-2.5 rounded-lg hover:bg-green-dark transition-all duration-200 flex items-center space-x-2 shadow-md hover:shadow-lg transform hover:scale-105" do %>
            <%= render "shared/svg_icons/cart", class: "w-4 h-4" %>
            <span class="font-semibold">Add</span>
          <% end %>
        <% end %>
      <% else %>
        <button type="button" class="bg-green-primary text-white px-6 py-2.5 rounded-lg opacity-60 flex items-center space-x-2 shadow-md" disabled>
          <%= render "shared/svg_icons/cart", class: "w-4 h-4" %>
          <span class="font-semibold">Add</span>
        </button>
      <% end %>
    </div>
  </div>
</div>
